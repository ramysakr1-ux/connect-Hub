{
  "name": "connect-lite",
  "private": true,
  "type": "module",
  "description": "Connect Lite is a static site \u2014 this package.json exists only so the screen check has a runner. Nothing here is deployed; GitHub Pages serves the HTML, JS and CSS and ignores the rest.",
  "scripts": {
    "check": "node check-screens.mjs",
    "check:data": "node walk-with-data.mjs",
    "check:doors": "DOORS=1 node walk-with-data.mjs",
    "walk": "node walk-roles.mjs",
    "cohort": "node walk-cohort.mjs",
    "demo": "node demo-mint.mjs",
    "demo:clear": "node demo-clear.mjs",
    "check:live": "node check-live.mjs",
    "check:phone": "node check-phone.mjs",
    "check:roles": "node store/sweep-roles.mjs"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  }
}
