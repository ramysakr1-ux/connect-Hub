node_modules/
package-lock.json

# the owner key mints and deletes courses — it never belongs in the repo
.owner-key
# the course the TP point library lives on. tools/st.mjs reads it from here or
# from LIBRARY_KEY; every check used to have it typed into the source.
.library-key
_store-snapshots/
.owner-key.previous

# The C/17 pages are back on the site (27 Sep 2026): the assessor needs to
# reach the pack on Tuesday, and Drive will not display an HTML file as a
# page. They carry no working key -- the one that was published is rotated
# and dead, and the page reads any key from the address.
#
# THE RULE THAT STANDS: never commit a working key into these files. That is
# what made C/17's grades readable by anyone who found this public repo.

# Recorded takes of the film -- big, and the repository is public
film/takes/

# The film's music: licensed to use IN the film, not to republish as a file
film/music.mp3
film/music-trailer.mp3
film/music-documentary.mp3

# The film as WebM is kept locally only; the site serves the MP4
film/connect-lite-film.webm
tools/audio-gaps.json
tools/pagemap.json

# Snapshots of the TP point library, taken before anything writes to it. They
# carry every Drive link the library has and this repository is public.
_library-backups/

# screenshots walk-with-data.mjs keeps when SHOTS=1
_walk-shots/

# clasp's login token lives in the home folder, never here; listed in case it
# ever lands in the repo by mistake (6 Oct 2026, the move to the Mac)
.clasprc.json
